FROM node:20-alpine AS base

WORKDIR /app

RUN apk add --no-cache openssl

COPY package*.json ./
COPY tsconfig.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/shared/package*.json ./packages/shared/

RUN npm ci --workspace=apps/api --workspace=packages/shared

COPY packages/shared/ ./packages/shared/
COPY prisma/ ./prisma/
COPY apps/api/ ./apps/api/

RUN npx prisma generate

FROM base AS development

CMD ["npm", "run", "dev:api"]

FROM base AS build

RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/api

FROM node:20-alpine AS production

WORKDIR /app

RUN apk add --no-cache openssl

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/prisma ./prisma

RUN node -e "const fs=require('fs'); const p='/app/packages/shared/package.json'; const j=JSON.parse(fs.readFileSync(p,'utf8')); j.main='./dist/index.js'; j.types='./dist/index.d.ts'; fs.writeFileSync(p, JSON.stringify(j,null,2));"

ENV NODE_ENV=production

EXPOSE 3000

CMD ["node", "apps/api/dist/server.js"]